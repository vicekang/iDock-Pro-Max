+function commandChats(value: unknown): Record<string, string> | undefined {
+  if (value === undefined) return undefined;
+  if (!value || typeof value !== 'object' || Array.isArray(value)) throw new Error('commandChats must map chat IDs to owner IDs');
+  const result: Record<string, string> = {};
+  for (const [chat, owner] of Object.entries(value)) {
+    if (!/^oc_[a-zA-Z0-9]+$/.test(chat) || typeof owner !== 'string' || !/^ou_[a-zA-Z0-9]+$/.test(owner)) {
+      throw new Error('commandChats requires a valid chat ID and one human owner ID');
+    }
+    result[chat] = owner;
+  }
+  return result;
+}
