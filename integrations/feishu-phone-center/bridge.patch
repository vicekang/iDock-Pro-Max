@@ -0,0 +1,26 @@
+import { describe, it, expect } from 'vitest';
+import { commandChatIntake, canUseGroup } from '../../../src/policy/access';
+import { createDefaultProfileConfig, normalizeProfileConfig } from '../../../src/config/profile-schema';
+import { accessPolicyDigest } from '../../../src/policy/fingerprint';
+
+const profile = createDefaultProfileConfig({ agentKind: 'codex', codex: {binaryPath: '/usr/local/bin/codex'}, accounts: { app: { id: 'cli_test', secret: 'test', tenant: 'feishu' } },
+  access: { commandChats: { oc_center: 'ou_owner' }, allowedChats: ['oc_center'], admins: ['ou_admin'] } });
+describe('dedicated command chat', () => {
+  it('accepts only the authenticated human owner, without requiring mention', () => {
+    expect(commandChatIntake(profile.access, 'oc_center', 'ou_owner', 'user')).toBe('accept');
+    expect(commandChatIntake(profile.access, 'oc_center', 'ou_owner', 'bot')).toBe('drop');
+    expect(commandChatIntake(profile.access, 'oc_center', 'ou_owner', undefined)).toBe('drop');
+    expect(commandChatIntake(profile.access, 'oc_center', 'ou_other', 'user')).toBe('drop');
+    expect(commandChatIntake(profile.access, 'oc_other', 'ou_other', 'user')).toBe('ordinary');
+  });
+  it('cannot bypass the owner restriction through group allowlist, admin or creator', () => {
+    for (const sender of ['ou_admin', 'ou_other', 'ou_creator']) {
+      expect(canUseGroup(profile, { botOwnerId: 'ou_creator', ownerRefreshState: 'ok' }, 'oc_center', sender).ok).toBe(false);
+    }
+  });
+  it('preserves and fingerprints the owner binding and rejects malformed bindings', () => {
+    expect(normalizeProfileConfig(profile).access.commandChats).toEqual({oc_center: 'ou_owner'});
+    expect(accessPolicyDigest(profile.access)).not.toBe(accessPolicyDigest({...profile.access, commandChats: {oc_center: 'ou_other'}}));
+    expect(() => normalizeProfileConfig({...profile, access: {...profile.access, commandChats: {oc_center: ''}}})).toThrow();
+  });
+});
